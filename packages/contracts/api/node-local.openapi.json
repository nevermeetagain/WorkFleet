    "/hooks/{hookId}": {
      "post": {
        "summary": "Webhook 输入（端口 5102）；头 X-WorkFleet-Timestamp（unix 秒，±300 s）与 X-WorkFleet-Signature: sha256=HMAC(secret, timestamp + '.' + body)；失败 401 WEBHOOK_SIGNATURE_INVALID；X-WorkFleet-Id 24h 去重",
        "x-auth": "hmac",
        "responses": {
          "202": {
            "description": "OK"
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "priority": {
                    "enum": [
                      "p0",
                      "p1",
                      "p2",
                      "p3"
                    ]
                  },
                  "fields": {
                    "type": "object"
                  },
                  "barrierId": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        }
      }
    },
