              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "https://workfleet.dev/contracts/v1/schemas/entities/model-profile.schema.json"
                  }
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "新建（apiKey 只在请求中出现一次，写入钥匙串后返回 keyRef）",
        "x-auth": "local",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/entities/model-profile.schema.json"
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "profile": {
                    "type": "object"
                  },
                  "apiKey": {
                    "type": "string"
                  }
                },
                "required": [
                  "profile",
                  "apiKey"
                ]
              }
            }
          }
        }
      }
    },
    "/local/v1/model-profiles/{modelProfileId}": {
      "patch": {
        "summary": "修改（可选 apiKey 轮换）",
        "x-auth": "local",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/entities/model-profile.schema.json"
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "profile": {
                    "type": "object"
                  },
                  "apiKey": {
                    "type": "string"
                  }
                },
                "required": []
              }
            }
          }
        }
      },
      "delete": {
        "summary": "删除并清除钥匙串条目",
        "x-auth": "local",
        "responses": {
          "204": {
            "description": "OK"
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/local/v1/model-profiles/{modelProfileId}/test": {
      "post": {
        "summary": "连通性测试（返回延迟与 usage）",
        "x-auth": "local",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/local/v1/usage": {
      "get": {
        "summary": "用量与费用（日/月，按配置）",
        "x-auth": "local",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "periods": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "modelProfileId": {
                            "type": "string"
                          },
                          "period": {
                            "enum": [
                              "day",
                              "month"
                            ]
                          },
                          "start": {
                            "type": "string"
                          },
                          "inputTokens": {
                            "type": "integer"
                          },
                          "outputTokens": {
                            "type": "integer"
                          },
                          "costMicros": {
                            "type": "integer"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "limitMicros": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "exceeded": {
                            "type": "boolean"
                          },
                          "estimated": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "modelProfileId",
                          "period",
                          "start",
                          "inputTokens",
                          "outputTokens",
                          "costMicros",
                          "currency",
                          "limitMicros",
                          "exceeded",
                          "estimated"
                        ]
                      }
                    }
                  },
                  "required": [
                    "periods"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/local/v1/supervisor": {
      "get": {
        "summary": "总控设置：模型配置、把关规则、降级状态",
        "x-auth": "local",
        "responses": {
