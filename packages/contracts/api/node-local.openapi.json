{
  "openapi": "3.1.0",
  "info": {
    "title": "WorkFleet Node Local API",
    "version": "1.0.0",
    "description": "只绑 127.0.0.1:5100（/hooks 在 5102）。x-auth=local：本机随机令牌（启动时写入用户目录 0600 文件，本机 Web 通过同源 Cookie 获取）。模型 Key 只在此 API 的请求体出现一次。 本机鉴权（x-auth=local）：节点启动时生成 256 bit 随机令牌，写入用户数据目录 local-token 文件（0600 / Windows 仅当前用户 ACL）；本机 Web 由节点同源下发 HttpOnly Cookie；CLI 读文件放入 Authorization: Bearer；拒绝非 127.0.0.1 来源与非同源 Origin。"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "paths": {
    "/local/v1/status": {
      "get": {
        "summary": "节点状态：版本、中转连接、智能体、资源占用",
        "x-auth": "local",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/local/v1/relay-links": {
      "get": {
        "summary": "中转连接列表",
        "x-auth": "local",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "https://workfleet.dev/contracts/v1/schemas/entities/relay-link.schema.json"
                  }
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "新增中转（url + 配对码）",
        "x-auth": "local",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/entities/relay-link.schema.json"
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "pairingCode": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "pairingCode",
                  "label"
                ]
              }
            }
          }
        }
      }
    },
    "/local/v1/relay-links/{relayLinkId}": {
      "delete": {
        "summary": "断开并删除",
        "x-auth": "local",
        "responses": {
          "204": {
            "description": "OK"
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/local/v1/adapters/detect": {
      "get": {
        "summary": "探测本机已安装的智能体可执行文件与版本",
        "x-auth": "local",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/local/v1/model-profiles": {
