        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "dir": {
                    "type": "string"
                  },
                  "dryRun": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "dir"
                ]
              }
            }
          }
        }
      }
    },
    "/local/v1/twin/events": {
      "get": {
        "summary": "分身事件分页",
        "x-auth": "local",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "https://workfleet.dev/contracts/v1/schemas/entities/twin-event.schema.json"
                  }
                }
              }
            }
