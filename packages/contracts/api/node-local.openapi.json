              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "新建 Webhook 端点（返回一次性密钥）",
        "x-auth": "local",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "hook": {
                      "$ref": "https://workfleet.dev/contracts/v1/schemas/entities/webhook-hook.schema.json"
                    },
                    "secret": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "hook",
                    "secret"
                  ]
                }
              }
            }
          },
          "default": {
