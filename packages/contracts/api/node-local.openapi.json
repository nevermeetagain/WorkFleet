            }
          }
        }
      }
    },
    "/local/v1/recovery-key/import": {
      "post": {
        "summary": "导入恢复密钥",
        "x-auth": "local",
        "responses": {
          "204": {
            "description": "OK"
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
