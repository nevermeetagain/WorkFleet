    "/local/v1/recovery-key/export": {
      "post": {
        "summary": "导出恢复密钥（需本机系统认证确认）",
        "x-auth": "local",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
