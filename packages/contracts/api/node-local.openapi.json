            }
          }
        }
      },
      "put": {
        "summary": "更新总控设置",
        "x-auth": "local",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://workfleet.dev/contracts/v1/schemas/common/error.schema.json"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "modelProfileId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rules": {
                    "type": "array"
                  },
                  "systemPrompt": {
                    "type": "string"
                  }
                },
                "required": []
              }
            }
          }
        }
      }
    },
    "/local/v1/supervisor/import-tasks": {
