{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workfleet.dev/contracts/v1/protocol/envelope.schema.json",
  "title": "envelope",
  "description": "中转↔节点 WSS 帧（ADR-005）。每方向 seq 单调递增；ack/ping/hello/welcome 不占 seq（seq=0）。接收方按 idempotencyKey 去重；重连后从对端 lastAcked+1 续传。单帧 ≤ 1 MiB。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "description": "协议版本；hello/welcome 协商，不支持则 error PROTOCOL_VERSION_UNSUPPORTED"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "hello",
        "welcome",
        "ack",
        "ping",
        "agent.prompt",
        "agent.cancel",
        "agent.clear",
        "agent.output",
        "agent.status",
        "approval.request",
        "approval.decision",
        "agents.sync",
        "history.query",
        "history.result",
        "emergency.stop",
        "emergency.resume",
        "twin.capture",
        "barrier.submit",
        "error",
        "agent.upsert",
        "agent.remove",
        "route.sync",
        "approval.cancel",
        "approval.assigned",
        "conversation.open",
        "conversation.opened",
        "adapters.detected",
        "device.token_rotated"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "traceId": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/traceId"
    },
    "sentAt": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/timestamp.schema.json"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "v",
    "seq",
    "type",
    "idempotencyKey",
    "traceId",
    "sentAt",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://workfleet.dev/contracts/v1/protocol/frames/hello.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "welcome"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://workfleet.dev/contracts/v1/protocol/frames/welcome.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
