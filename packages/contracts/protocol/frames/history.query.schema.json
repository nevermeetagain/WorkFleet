{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workfleet.dev/contracts/v1/protocol/frames/history.query.schema.json",
  "title": "history.query",
  "description": "帧 history.query，方向：relay",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "conversationId": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/conversationId"
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "q": {
      "type": "string",
      "minLength": 0,
      "maxLength": 200
    }
  },
  "required": [
    "requestId",
    "conversationId",
    "limit"
  ]
}
