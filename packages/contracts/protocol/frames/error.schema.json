{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workfleet.dev/contracts/v1/protocol/frames/error.schema.json",
  "title": "error",
  "description": "帧 error，方向：both",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "refSeq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "code",
    "message"
  ]
}
