  "extraRules": [
    {
      "action": "approval.decide_high",
      "allowIf": "principal.userId == device.ownerUserId"
    },
    {
      "action": "device.revoke",
      "allowIf": "principal.userId == device.ownerUserId"
    }
  ],
  "forbiddenPaths": [
    {
      "desc": "任何角色不得跨 tenant 访问",
      "check": "resource.tenantId == principal.tenantId else 404 NOT_FOUND（不泄露存在性）"
    },
    {
      "desc": "viewer 不得调用任何非 GET 端点（notification.subscribe 除外）",
      "check": "403 FORBIDDEN"
    },
    {
      "desc": "中转任何端点不得返回或接收模型 Key",
      "check": "schema 中不存在该字段；secret-scan 测试"
    },
    {
      "desc": "设备令牌只能调用 node-gateway，不能调用 Web API",
      "check": "401 UNAUTHENTICATED"
    },
    {
      "desc": "IM 未授权发送者不得触发路由",
      "check": "recipient.authorized=false → 只回固定提示"
    }
  ]
