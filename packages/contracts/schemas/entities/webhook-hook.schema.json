{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workfleet.dev/contracts/v1/schemas/entities/webhook-hook.schema.json",
  "title": "webhook-hook",
  "description": "Webhook 输入端点（节点本机）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/hookId"
    },
    "agentId": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/agentId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "secretRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "defaultPriority": {
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ]
    },
    "createdAt": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/timestamp.schema.json"
    }
  },
  "required": [
    "id",
    "agentId",
    "name",
    "secretRef",
    "defaultPriority",
    "createdAt"
  ]
}
