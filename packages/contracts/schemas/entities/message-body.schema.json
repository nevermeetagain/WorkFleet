{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workfleet.dev/contracts/v1/schemas/entities/message-body.schema.json",
  "title": "message-body",
  "description": "小 IR（DEC-024）：渠道无关的内容块，由 delivery 按 capabilities 渲染",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "paragraph"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "heading"
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "level",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "list"
              },
              "ordered": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            },
            "required": [
              "type",
              "ordered",
              "items"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "code"
              },
              "lang": {
                "type": "string",
                "minLength": 0,
                "maxLength": 20
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50000
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "table"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            },
            "required": [
              "type",
              "columns",
              "rows"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "callout"
              },
              "tone": {
                "type": "string",
                "enum": [
                  "info",
                  "warn",
                  "error",
                  "success"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "type",
              "tone",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "kpi"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "delta": {
                "type": "string",
                "minLength": 0,
                "maxLength": 40
              }
            },
            "required": [
              "type",
              "label",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "attachment"
              },
              "attachmentId": {
                "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/attachmentId"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "mime": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "type",
              "attachmentId",
              "name",
              "mime",
              "sizeBytes"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "approval"
              },
              "approvalId": {
                "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/approvalId"
              }
            },
            "required": [
              "type",
              "approvalId"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "status_card"
              },
              "state": {
                "type": "string",
                "enum": [
                  "queued",
                  "running",
                  "waiting",
                  "done",
                  "failed"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "progress": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "type",
              "state",
              "title"
            ]
          }
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "description": "例 [项目A/z1]"
    },
    "fields": {
      "type": "object",
      "description": "结构化字段，供过滤与脱敏（G3）使用"
    }
  },
  "required": [
    "blocks"
  ]
}
