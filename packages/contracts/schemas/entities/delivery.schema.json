{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workfleet.dev/contracts/v1/schemas/entities/delivery.schema.json",
  "title": "delivery",
  "description": "投递（outbox）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/deliveryId"
    },
    "messageId": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/messageId"
    },
    "recipientId": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/recipientId"
    },
    "channelId": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/channelId"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "sent",
        "failed",
        "dead",
        "suppressed"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "renderedAs": {
      "type": "string",
      "enum": [
        "card",
        "markdown",
        "text",
        "digest"
      ]
    },
    "filtersApplied": {
      "type": "array",
      "items": {
        "$ref": "https://workfleet.dev/contracts/v1/schemas/common/ids.schema.json#/$defs/filterRuleId"
      }
    },
    "lastError": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "platformMessageId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "createdAt": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/timestamp.schema.json"
    },
    "updatedAt": {
      "$ref": "https://workfleet.dev/contracts/v1/schemas/common/timestamp.schema.json"
    }
  },
  "required": [
    "id",
    "messageId",
    "recipientId",
    "channelId",
    "status",
    "attempts",
    "renderedAs",
    "filtersApplied",
    "lastError",
    "platformMessageId",
    "createdAt",
    "updatedAt"
  ]
}
