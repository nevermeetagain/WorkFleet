{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workfleet.dev/contracts/v1/schemas/common/money.schema.json",
  "title": "money",
  "description": "金额：整数微单位 + ISO 4217",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "amountMicros": {
      "type": "integer"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "required": [
    "amountMicros",
    "currency"
  ]
}
